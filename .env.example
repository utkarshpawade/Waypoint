# ─── LLM (OpenAI-compatible endpoint; swap provider with these 3 vars) ───────
# Groq (console.groq.com) — measured ~0.9s per interpretation.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
#
# Gemini (aistudio.google.com) — works, but ~5.8s per call because Flash 3.x
# spends ~600 reasoning tokens before answering:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-3.6-flash
#
# Model names go stale fast. List what a key can actually reach with:
#   curl -H "Authorization: Bearer $LLM_API_KEY" "$LLM_BASE_URL/models"
#
# Leave LLM_API_KEY empty to run entirely on the deterministic rules engine.

# ─── Database (Neon Postgres) ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# ─── Email (Gmail app password, or Brevo relay as fallback) ─────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="Waypoint Travel <you@gmail.com>"

# ─── Flights ────────────────────────────────────────────────────────────────
FLIGHT_PROVIDER=mock
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# ─── App ────────────────────────────────────────────────────────────────────
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
CHANNEL=whatsapp
ADMIN_TOKEN=change-me-to-something-long-and-random
OWNER_WHATSAPP=919876543210
WA_PAIRING_NUMBER=919876543211
ESCALATION_SLA_MINUTES=10
BUSINESS_HOURS=09:00-22:00
BUSINESS_TZ=Asia/Kolkata
LOG_LEVEL=info
