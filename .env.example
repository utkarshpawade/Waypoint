# ─── LLM (OpenAI-compatible endpoint; swap provider with these 3 vars) ───────
# Groq (console.groq.com) — measured ~0.9s per interpretation.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
#
# Gemini (aistudio.google.com) — works, but ~5.8s per call because Flash 3.x
# spends ~600 reasoning tokens before answering:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-3.6-flash
#
# Model names go stale fast. List what a key can actually reach with:
#   curl -H "Authorization: Bearer $LLM_API_KEY" "$LLM_BASE_URL/models"
#
# Leave LLM_API_KEY empty to run entirely on the deterministic rules engine.

# ─── Database (Neon Postgres) ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# ─── Email ──────────────────────────────────────────────────────────────────
# Render's FREE tier blocks outbound SMTP (ports 25/465/587), so on Render use
# Brevo's HTTPS API: brevo.com → SMTP & API → API keys. MAIL_FROM must then be
# a sender verified in Brevo (Senders & IP → Senders). When set, it wins.
BREVO_API_KEY=
# SMTP (Gmail app password) — fine locally or on a paid host:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="Waypoint Travel <you@gmail.com>"

# ─── Flights ────────────────────────────────────────────────────────────────
# mock = deterministic sample fares (no key needed)
# skyscanner = live Skyscanner fares via RapidAPI: subscribe to the "Sky Scrapper"
#              API on rapidapi.com and paste your RapidAPI key below
# amadeus = Amadeus self-service test tier (limited routes, stale prices)
FLIGHT_PROVIDER=mock
RAPIDAPI_KEY=
RAPIDAPI_SKYSCANNER_HOST=sky-scrapper.p.rapidapi.com
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# ─── App ────────────────────────────────────────────────────────────────────
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# cloud = Meta WhatsApp Cloud API (official, free test number, no ban risk,
#         but a test number may only message pre-registered recipients)
# whatsapp = Baileys (unofficial, any recipient, real ban risk)
# cli / memory = local development and tests
CHANNEL=whatsapp
ADMIN_TOKEN=change-me-to-something-long-and-random

# Only answer these numbers (comma-separated). Empty = answer everyone.
# Set it when the bot shares a number with a human: named senders get the bot,
# everyone else's messages reach the person untouched.
ALLOWED_SENDERS=

# --- WhatsApp Cloud API (CHANNEL=cloud) ---
WA_CLOUD_TOKEN=                       # Meta dashboard -> WhatsApp -> API Setup
WA_CLOUD_PHONE_NUMBER_ID=             # same page, NOT the phone number itself
WA_CLOUD_VERIFY_TOKEN=pick-any-string # paste the same value into Meta's webhook config
WA_CLOUD_APP_SECRET=                  # App settings -> Basic -> App secret

# Escalation alerts go here. On a test number this must be whitelisted too.
OWNER_WHATSAPP=919876543210

# --- Baileys only (CHANNEL=whatsapp) ---
WA_PAIRING_NUMBER=919876543211
# The human a handed-off user hears from, in chat and in the email.
AGENT_NAME=Utkarsh
AGENT_TITLE=Customer Care, Waypoint Travel

ESCALATION_SLA_MINUTES=10
BUSINESS_HOURS=09:00-22:00
BUSINESS_TZ=Asia/Kolkata
LOG_LEVEL=info
