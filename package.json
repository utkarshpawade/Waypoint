{
  "name": "waypoint",
  "version": "1.0.0",
  "private": true,
  "description": "Waypoint — WhatsApp flight concierge with human escalation",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "cli": "cross-env CHANNEL=cli tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:push": "tsx scripts/migrate.ts",
    "email:test": "tsx scripts/send-test-email.ts",
    "rank:demo": "tsx scripts/rank-demo.ts"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.9",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "luxon": "^3.5.0",
    "nodemailer": "^6.9.16",
    "openai": "^4.77.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "cross-env": "^7.0.3",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
